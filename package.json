{
  "name": "rrnnm-fans",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "skeb:summary": "node scripts/skeb-summary.ts",
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node scripts/deploy-dist.mjs production",
    "typecheck": "astro check && tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:storybook": "vp test run --config vitest.storybook.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:floors": "node scripts/check-mutation-floors.mjs",
    "assets:pull": "node scripts/private-assets.mjs",
    "assets:overlay": "node scripts/private-assets.mjs --overlay-only",
    "docs:pull": "node scripts/private-docs.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "field:contrast": "node scripts/measure-field-contrast.mjs",
    "css:compare": "node scripts/compare-computed-style.mjs",
    "playlists:check": "node scripts/check-playlists.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build:test": "node scripts/build.mjs success",
    "test:ci": "node scripts/test-ci.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "deploy:preview": "node scripts/deploy-dist.mjs preview"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/react": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@fontsource/zen-maru-gothic": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "astro": "catalog:",
    "fast-check": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "storybook": "catalog:",
    "stylelint": "catalog:",
    "stylelint-plugin-use-baseline": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
