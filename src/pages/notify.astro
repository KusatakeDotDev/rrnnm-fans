---
// 配信スケジュールの更新の通知を受け取る設定のページ（ADR-0035 の決定）。トップの今週の配信予定のカードのスイッチ
// （src/unreleased/_parts/ScheduleNotify.astro）からも切り替えられ、そこから案内のリンクを張る。フッターにも並べる。
// 通知を公開するまでは、どちらのリンクも出さない（src/data/site-navigation.ts の UNLINKED_ROUTES）。
// 購読の確かめ方・始め方・やめ方は、トップのスイッチと同じもの（src/components/notify-subscription.ts）を使う。
//
// 文は1行に書く。文字と文字の間で改行すると、日本語の間に空白が1つ入る（about.astro と同じ）。
import Base from '../layouts/Base.astro';
import '../styles/subpage.css';
---

<Base
  title="配信スケジュールの更新の通知"
  description="瑠璃野ねもさんの今週の配信スケジュールが更新されたら、ブラウザの通知でお知らせします。受け取る設定と、やめ方のページです。"
>
  <Fragment slot="head">
    {/* 句ごとに <span> で包み、狭い画面ではこの境目で2行に分ける。 */}
    <h1><span>配信スケジュールの</span><span>更新の通知</span></h1>
  </Fragment>

  <div class="subpage-paper on-paper">
    <section>
      <p>今週の配信スケジュールが更新されたら、この端末に通知でお知らせします。やめるときも、このページでできます。</p>
      {/* 押せるかどうかはスクリプトが決めるので、決まるまでボタンは出さない。 */}
      <button type="button" class="toggle" data-notify-toggle hidden>通知を受け取る</button>
      <p class="status" role="status" data-notify-status></p>
    </section>
  </div>
</Base>

<script>
  import { availability, readStatus, subscribe, unsubscribe, type NotifyStatus } from '../components/notify-subscription';

  const button = document.querySelector<HTMLButtonElement>('[data-notify-toggle]')!;
  const status = document.querySelector<HTMLElement>('[data-notify-status]')!;

  const MESSAGE = {
    on: 'この端末は、通知を受け取る設定になっています。',
    ios: 'iPhone・iPad では、Safari の共有メニューから「ホーム画面に追加」したアプリで、このページを開くと設定できます。',
    unsupported: 'このブラウザでは、通知を受け取れません。',
    denied: '通知が許可されていません。ブラウザや端末の設定で、このサイトの通知を許可してください。',
    failed: '設定できませんでした。少しおいて、もう一度お試しください。',
  };

  let subscribed = false;
  const show = (next: NotifyStatus) => {
    subscribed = next === 'on';
    button.textContent = subscribed ? '通知をやめる' : '通知を受け取る';
    button.hidden = false;
    // 聞く画面を閉じただけ（off）なら、もう一度押せば聞き直せるので、設定を変えるようには言わない。
    status.textContent = next === 'on' ? MESSAGE.on : next === 'denied' ? MESSAGE.denied : '';
  };

  const available = availability();
  if (available !== 'available') {
    status.textContent = MESSAGE[available];
  } else {
    readStatus().then(show, () => show('off'));
    button.addEventListener('click', () => {
      button.disabled = true;
      (subscribed ? unsubscribe() : subscribe())
        .then(show, () => (status.textContent = MESSAGE.failed))
        .finally(() => (button.disabled = false));
    });
  }
</script>

<style>
  @layer pages {
    h1 {
      margin: 0;
    }

    h1 span {
      display: inline-block;
    }

    /* 押せるステッカーの見た目（skeb.astro の .profile-cta と同じ）。 */
    .toggle {
      align-self: flex-start;
      min-height: var(--tap-size);
      border: var(--border-thumb) solid var(--color-outline);
      border-radius: var(--radius-pill);
      padding: var(--space-1) var(--space-5);
      background-color: var(--color-fill-blue-deep);
      color: var(--color-text-on-fill);
      box-shadow: var(--offset-button) var(--offset-button) 0 var(--color-outline);
      font: inherit;
      font-size: var(--text-small);
      font-weight: 700;
      cursor: pointer;
      transition:
        transform 0.12s ease,
        box-shadow 0.12s ease;
    }

    .toggle:hover,
    .toggle:focus-visible {
      box-shadow: var(--offset-pressed) var(--offset-pressed) 0 var(--color-outline);
      transform: translate(var(--offset-pressed), var(--offset-pressed));
    }

    .toggle:disabled {
      cursor: progress;
    }

    @media (prefers-reduced-motion: reduce) {
      .toggle {
        transition: none;
      }
    }
  }
</style>
