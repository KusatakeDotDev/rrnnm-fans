---
// ミニゲームの一覧（docs/DESIGN.md §1 の /play。ADR-0015 の決定）。入口はフッター（src/data/site-navigation.ts の PAGE_LINKS）。
// TODO(RRNNM-11): ナビとトップの入口ブロックからも入れるようにする。
// 1本ずつのページはフッターに並べず、ここから入る。ここのリンクとビルドした /play/<slug>/ は、tests/conformance/routes.spec.ts が照らし合わせる。
// 並びは公開した新しい順。カードの絵は、YouTube のサムネイルを出してよい例外（docs/CONCEPT.md）に当たらないので、ゲームの見た目を描く。
import Base from '../../layouts/Base.astro';
import { ROUND_MS } from '../../lib/alt-f4';
import AltF4Art from './_alt-f4/CardArt.astro';
import KusobakaSlotArt from './_kusobaka-slot/CardArt.astro';

const GAMES = [
  {
    href: '/play/alt-f4/',
    title: '配信をとじろ！',
    howTo: `次々に開く配信のウィンドウを、${ROUND_MS / 1000}秒のうちに何枚とじられるか。`,
    sound: 'BGM あり',
    Art: AltF4Art,
  },
  {
    href: '/play/kusobaka-slot/',
    title: 'クソバカスロット',
    howTo: '4本のリールを止めて「クソバカ」をそろえる。',
    sound: '効果音あり',
    Art: KusobakaSlotArt,
  },
];
---

<Base title="あそぶ" description="瑠璃野ねもさんにちなんだ、ファンが作ったミニゲームの一覧です。">
  <Fragment slot="head">
    <h1>あそぶ</h1>
  </Fragment>

  <ul class="games" role="list">
    {
      GAMES.map(({ href, title, howTo, sound, Art }) => (
        <li>
          <a class="game on-paper" href={href}>
            <Art />
            <h2 class="title">{title}</h2>
            <p>{howTo}</p>
            {/* 「非公式のファン制作」はカードごとに出す（docs/DESIGN.md §1「ミニゲームの導線」）。 */}
            <span class="tags">
              <span>{sound}</span>
              <span class="fan">非公式のファン制作</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  @layer pages {
    h1 {
      margin: 0;
    }

    .games {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10);
      width: 100%;
      max-width: 60rem;
      margin: var(--space-12) auto 0;
      padding: 0;
      list-style: none;
    }

    .game {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      height: 100%;
      border: var(--border-card) solid var(--color-outline);
      border-radius: var(--radius-card);
      padding: var(--space-5) var(--space-5) var(--space-6);
      box-shadow: var(--offset-card) var(--offset-card) 0 var(--color-outline);
      text-decoration-line: none;
      transition: box-shadow 0.15s ease;
    }

    /* 押し込まれた見え方。影が縮む（トップの再生リストのタイルと同じ。PlaylistGrid.module.css）。 */
    .game:hover,
    .game:focus-visible {
      box-shadow: var(--offset-pressed) var(--offset-pressed) 0 var(--color-outline);
    }

    .game:hover .title,
    .game:focus-visible .title {
      text-decoration-line: underline;
    }

    .title {
      margin: var(--space-2) 0 0;
      font-size: var(--text-h3);
    }

    .game p {
      margin: 0;
    }

    /* あそびかたの行の数がカードごとに違っても、タグの行の高さをそろえる。 */
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: auto;
      padding-top: var(--space-2);
    }

    .tags span {
      border: var(--border-thumb) solid var(--color-outline);
      border-radius: var(--radius-pill);
      padding: 0 var(--space-3);
      font-size: var(--text-small);
      font-weight: 700;
    }

    .tags .fan {
      background-color: var(--color-fill-lavender);
    }

    @media (max-width: 40rem) {
      .games {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-8);
        margin-top: var(--space-8);
      }

      .game {
        border-width: var(--border-sticker);
        border-radius: var(--radius-tile);
        padding: var(--space-4);
        box-shadow: var(--offset-tile) var(--offset-tile) 0 var(--color-outline);
      }
    }
  }
</style>
