---
// 一覧（src/pages/play/index.astro）のカードの絵。ゲームのデスクトップに、配信のウィンドウが重なって開いたところを描く。
// 前のウィンドウの中には、YouTube のサムネイルではなく、いらすとやの絵を出す。サムネイルは、ゲームのウィンドウの中のリンクにだけ出す（ADR-0033 の決定）。
// 絵は LICENSE の「第三者の素材」。
import vtuber from './vtuber.webp';

const WINDOWS = [
  { x: 40, y: 20 },
  { x: 92, y: 48 },
  { x: 144, y: 76 },
];
---

<div class="art">
  <svg viewBox="0 0 320 200" aria-hidden="true" focusable="false">
    {
      WINDOWS.map(({ x, y }, index) => (
        <g transform={`translate(${x} ${y})`}>
          <rect class="window" width="136" height="88" />
          <rect class="titlebar" width="136" height="16" />
          <rect class="close" x="114" y="2.5" width="18" height="11" rx="2" />
          <path class="cross" d="M120 5.5l6 5M126 5.5l-6 5" />
          <rect class="screen" x="5" y="21" width="126" height="62" />
          {index === WINDOWS.length - 1 && <image href={vtuber.src} x="5" y="21" width="126" height="62" />}
        </g>
      ))
    }
    <rect class="taskbar" y="182" width="320" height="18" />
    <rect class="start" x="-10" y="182" width="74" height="18" rx="9" />
    <text class="start-label" x="12" y="195" font-size="10">スタート</text>
  </svg>
</div>

<style>
  @layer pages {
    .art {
      overflow: hidden;
      border: var(--border-thumb) solid var(--color-outline);
      border-radius: var(--radius-thumb);
      background: linear-gradient(
        to bottom,
        var(--c-altf4-sky-1) 0%,
        var(--c-altf4-sky-2) 62%,
        var(--c-altf4-hill-1) 62%,
        var(--c-altf4-hill-2) 100%
      );
    }

    svg {
      display: block;
      width: 100%;
      height: auto;
    }

    .window {
      fill: var(--c-altf4-window);
      stroke: var(--c-altf4-window-edge);
    }

    .titlebar {
      fill: var(--c-altf4-title-2);
    }

    .close {
      fill: var(--c-altf4-close-2);
      stroke: var(--color-text-on-fill);
    }

    .cross {
      stroke: var(--color-text-on-fill);
      stroke-width: 1.5;
      stroke-linecap: round;
    }

    .screen {
      fill: var(--color-fill-pale);
    }

    .taskbar {
      fill: var(--c-altf4-taskbar-2);
    }

    .start {
      fill: var(--c-altf4-start-2);
    }

    .start-label {
      fill: var(--color-text-on-fill);
      font-style: italic;
      font-weight: 700;
    }
  }
</style>
