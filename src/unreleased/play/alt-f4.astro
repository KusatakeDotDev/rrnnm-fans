---
// 配信のウィンドウを閉じるミニゲーム。昔のパソコンで、広告のウィンドウが次々に開いて止まらなくなったときの見た目を借り、
// ウィンドウに瑠璃野ねもさんの動画・配信のサムネイルを出す。制限時間のうちに閉じた数を数える。
// フッターには出さない（src/data/site-navigation.ts の UNLINKED_ROUTES）。
// サムネイルは、その動画の視聴ページへのリンクの中にだけ出し、押すと視聴ページを別のウィンドウで開く（ADR-0033 の決定）。
// 遊んでいるあいだに配信を押したら、その回はそこで終え、× 以外を押したら10枚の連鎖を起こす（RRNNM-116）。
// スタートのボタンだけでは始め方が分かりにくかったので、昔のパソコンの手伝いのキャラクターのように、妖精が吹き出しで
// 始めるかを尋ねる（RRNNM-112）。妖精の絵はいらすとやの素材（LICENSE の「第三者の素材」）。
import { OFFICIAL } from '../../data/official';
import Base from '../../layouts/Base.astro';
import { BGM_LEVEL, BGM_LEVEL_MAX, ROUND_MS } from '../../lib/alt-f4';
import fairy from './_alt-f4/fairy.webp';
---

<Base title="配信をとじろ" description="次々に開く配信のウィンドウを、制限時間のうちに何枚とじられるかのミニゲームです。ウィンドウには瑠璃野ねもさんの動画のサムネイルが出ます。">
  <Fragment slot="head">
    <h1>配信をとじろ</h1>
  </Fragment>

  {/* デスクトップの中を押すと配信のウィンドウが開くので、BGM はその外に置く。JS が無いと鳴らせないので、押せない形で出す（スクリプトが disabled を外す）。 */}
  <div class="bgm" data-altf4-bgm>
    <button type="button" class="bgm-toggle" aria-pressed="false" data-altf4-bgm-toggle disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path class="body" d="M3 9h4l5-4v14l-5-4H3z" />
        <path class="waves" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
        <path class="cross" d="M16 9l6 6M22 9l-6 6" />
      </svg>
      BGM
    </button>
    <input type="range" class="bgm-volume" min="0" max={BGM_LEVEL_MAX} step="5" value={BGM_LEVEL} aria-label="BGM の音量" data-altf4-bgm-volume disabled />
  </div>

  <div class="desktop" data-altf4-desktop>
    <div class="popups" data-altf4-popups>
      {/* 吹き出しの言葉は、サムネイルを取り終えたか・1回遊んだかで変わるので、スクリプトが書いて開く。 */}
      <div class="assistant" data-altf4-assistant>
        <div class="balloon" id="altf4-balloon" data-altf4-balloon hidden>
          <p data-altf4-message></p>
          <div class="options" data-altf4-options hidden>
            <button type="button" data-altf4-yes>はい</button>
            <button type="button" data-altf4-no>いいえ</button>
          </div>
        </div>
        <button type="button" class="fairy" aria-label="妖精に話しかける" aria-controls="altf4-balloon" aria-expanded="false" data-altf4-fairy>
          <img src={fairy.src} width={fairy.width / 2} height={fairy.height / 2} alt="" />
        </button>
      </div>
    </div>
    <div class="taskbar">
      {/* サムネイルを取り終えるまで押せない形で出す（スクリプトが disabled を外す）。 */}
      <button type="button" class="start" data-altf4-start disabled>スタート</button>
      <p class="clock tabular" data-altf4-clock>0:{String(ROUND_MS / 1000).padStart(2, '0')}</p>
    </div>
  </div>
  <p class="sr-only" role="status" data-altf4-status></p>

  <p class="credit">
    出典：YouTube <a href={OFFICIAL.youtube} target="_blank" rel="noopener noreferrer">瑠璃野ねも<span class="sr-only">（YouTube チャンネル。外部サイトを新しいタブで開く）</span></a>
    <br />
    {/* 魔王魂の利用規約が、著作表記を求めるため。 */}
    BGM：<a href="https://maou.audio/" target="_blank" rel="noopener noreferrer">魔王魂<span class="sr-only">（外部サイトを新しいタブで開く）</span></a>
  </p>

  <template data-altf4-popup-template>
    <div class="popup" data-altf4-popup>
      <div class="titlebar">
        <span class="titlebar-text">瑠璃野ねも - YouTube</span>
        <button type="button" class="close" aria-label="閉じる" data-altf4-close>
          <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 2l6 6M8 2l-6 6" /></svg>
        </button>
      </div>
      {/* 行き先は、スクリプトが動画の視聴ページに差し替える。サムネイルが1枚も取れなかったときは、チャンネルのまま出す。 */}
      <a class="ad" href={OFFICIAL.youtube} target="_blank" rel="noopener noreferrer" data-altf4-ad>
        <span class="frame"><img alt="" referrerpolicy="no-referrer" decoding="async" data-altf4-image /></span>
        <span class="caption" data-altf4-caption></span>
        <span class="sr-only">（外部サイトを新しいタブで開く）</span>
      </a>
    </div>
  </template>
</Base>

<script>
  import {
    adWindowFeatures,
    boundsOf,
    CHAIN_COUNT,
    CHAIN_INTERVAL_MS,
    CHAIN_START_DIRECTION,
    CHAIN_START_MARGIN,
    centerPosition,
    chainStep,
    isCelebrating,
    maxPopupWidth,
    openingReopenDelay,
    openingWidth,
    pickVideos,
    randomPosition,
    remainingSeconds,
    ROUND_MS,
    shouldChain,
    SPAWN_INTERVAL_MS,
    type Direction,
    type Point,
  } from '../../lib/alt-f4';
  import { shuffle } from '../../lib/shuffle';
  import { OPENING_VIDEO_ID } from './_alt-f4/opening';
  import { loadThumbnails, loadVideoIds, type Thumbnail } from './_alt-f4/thumbnails';
  import { setUpBgm } from './_alt-f4/bgm';

  setUpBgm(document.querySelector<HTMLElement>('[data-altf4-bgm]')!);

  /** サムネイルを取り終えるのを待つ上限（ミリ秒）。過ぎたら、取れた分だけで始められるようにする。 */
  const LOAD_WAIT_MS = 5_000;
  /** 残り時間の表示を書き換える間（ミリ秒）。 */
  const CLOCK_INTERVAL_MS = 100;

  const desktop = document.querySelector<HTMLElement>('[data-altf4-desktop]')!;
  const layer = desktop.querySelector<HTMLElement>('[data-altf4-popups]')!;
  const assistant = layer.querySelector<HTMLElement>('[data-altf4-assistant]')!;
  const balloon = assistant.querySelector<HTMLElement>('[data-altf4-balloon]')!;
  const message = assistant.querySelector<HTMLElement>('[data-altf4-message]')!;
  const options = assistant.querySelector<HTMLElement>('[data-altf4-options]')!;
  const yesButton = assistant.querySelector<HTMLButtonElement>('[data-altf4-yes]')!;
  const noButton = assistant.querySelector<HTMLButtonElement>('[data-altf4-no]')!;
  const fairy = assistant.querySelector<HTMLButtonElement>('[data-altf4-fairy]')!;
  const startButton = desktop.querySelector<HTMLButtonElement>('[data-altf4-start]')!;
  const clock = desktop.querySelector<HTMLElement>('[data-altf4-clock]')!;
  const status = document.querySelector<HTMLElement>('[data-altf4-status]')!;
  const template = document.querySelector<HTMLTemplateElement>('[data-altf4-popup-template]')!;

  /** この回に出しているサムネイル。 */
  let thumbnails: Thumbnail[] = [];
  /** 次の回に出すサムネイル。取れたものから足していく。 */
  let upcoming: Thumbnail[] = [];
  let deck: Thumbnail[] = [];
  let ready = false;
  /** 前に遊んだときに閉じた数。まだ遊んでいなければ null。 */
  let lastScore: number | null = null;

  function openBalloon(open: boolean): void {
    balloon.hidden = !open;
    fairy.setAttribute('aria-expanded', String(open));
  }

  /** サムネイルを取り終えるまでは待ってもらい、終えたら始めるかを尋ねる。遊んだあとは、閉じた数を添えて尋ねる。 */
  function ask(): void {
    if (!ready) message.textContent = '配信をあつめています…';
    else if (lastScore === null) message.textContent = 'はじめますか？';
    else message.textContent = `記録: ${lastScore}\nもう一度遊びますか？`;
    options.hidden = !ready;
    openBalloon(true);
  }

  /**
   * 次の回に出す動画を一覧から選び直し、サムネイルを取り始める。取り終えるか LOAD_WAIT_MS が過ぎたら解決する。
   * 回ごとに別の配列に足すので、前の回の分が遅れて届いても、次の回には混ざらない。一覧も回ごとに取り直し、返す側が
   * 出どころを替えたら、開いたままのページも次の回から替わるようにする。
   */
  function prepare(): Promise<unknown> {
    const batch: Thumbnail[] = [];
    upcoming = batch;
    const loaded = loadVideoIds().then((ids) =>
      loadThumbnails(pickVideos(ids, Math.random), (thumbnail) => batch.push(thumbnail)),
    );
    return Promise.race([loaded, new Promise((resolve) => setTimeout(resolve, LOAD_WAIT_MS))]);
  }

  ask();
  void prepare().then(() => {
    ready = true;
    startButton.disabled = false;
    // 待ってもらっていた吹き出しが開いたままなら、続けて尋ねる。閉じられていたら、開き直さない。
    if (!balloon.hidden) ask();
  });

  /** 同じ配信が続けて出ないよう、全部を1回ずつ出してから混ぜ直す。 */
  function nextThumbnail(): Thumbnail | undefined {
    if (deck.length === 0) deck = shuffle(thumbnails, Math.random);
    return deck.pop();
  }

  let playing = false;
  let startedAt = 0;
  let closed = 0;
  let lastChainAt: number | null = null;
  /** 開いている途中の連鎖の数。× 以外を押すたびに連鎖を起こすので、いくつも重なる。 */
  let chains = 0;
  const timers = new Set<number>();

  function stopTimers(): void {
    for (const id of timers) clearInterval(id);
    timers.clear();
  }

  function formatClock(seconds: number): string {
    return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
  }

  /**
   * 制限時間を過ぎていたら終える（終わっていれば true）。時計の表示は 100 ms ごとにしか見ないので、
   * 過ぎてから気付くまでのあいだに、次の1枚が開いたり × が数えられたりしないよう、開く前と数える前にも見る。
   */
  function timeIsUp(): boolean {
    if (!playing) return true;
    if (performance.now() - startedAt < ROUND_MS) return false;
    finish();
    return true;
  }

  /**
   * ウィンドウを1枚作って、デスクトップに置く。置く位置は、置いたウィンドウの大きさから決めるので、大きさを変える `resize` は、
   * 位置を決める前に呼ぶ。
   */
  function spawn(
    positionFor: (bounds: ReturnType<typeof boundsOf>) => Point,
    thumbnail: Thumbnail | undefined = nextThumbnail(),
    resize?: (popup: HTMLElement) => void,
  ): HTMLElement {
    const popup = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const ad = popup.querySelector<HTMLAnchorElement>('[data-altf4-ad]')!;
    const image = popup.querySelector<HTMLImageElement>('[data-altf4-image]')!;
    const caption = popup.querySelector<HTMLElement>('[data-altf4-caption]')!;
    if (thumbnail) {
      ad.href = thumbnail.href;
      image.src = thumbnail.image;
      caption.textContent = thumbnail.title;
    } else {
      image.remove();
      caption.textContent = '瑠璃野ねもの YouTube チャンネル';
    }
    popup.style.visibility = 'hidden';
    // 妖精より下に重ねる。時間切れのあと、残ったウィンドウの上で尋ねるため。
    layer.insertBefore(popup, assistant);
    resize?.(popup);
    const bounds = boundsOf(
      { width: layer.clientWidth, height: layer.clientHeight },
      { width: popup.offsetWidth, height: popup.offsetHeight },
    );
    const { x, y } = positionFor(bounds);
    popup.style.left = `${x}px`;
    popup.style.top = `${y}px`;
    popup.style.visibility = '';
    return popup;
  }

  function spawnAnywhere(): void {
    spawn((bounds) => randomPosition(bounds, Math.random));
  }

  /** 連鎖。1枚めは内側のどこかに置き、そこから斜めにずらしながら続けて開き、端で跳ね返す。 */
  function startChain(): void {
    chains++;
    lastChainAt = performance.now();
    let opened = 0;
    let position: Point = { x: 0, y: 0 };
    let direction: Direction = CHAIN_START_DIRECTION;
    const id = window.setInterval(() => {
      if (timeIsUp()) return;
      spawn((bounds) => {
        if (opened === 0) {
          position = randomPosition(bounds, Math.random, CHAIN_START_MARGIN);
        } else {
          ({ position, direction } = chainStep(position, direction, bounds));
        }
        return position;
      });
      opened++;
      if (opened >= CHAIN_COUNT) {
        clearInterval(id);
        timers.delete(id);
        chains--;
      }
    }, CHAIN_INTERVAL_MS);
    timers.add(id);
  }

  // TODO(RRNNM-114): 特別仕様が終わったら、始める前の1枚と、それを開き直す仕組みを消す
  /** 始める前に置いた1枚。× で閉じられるのは、遊ぶ前のこの1枚だけ。 */
  let opening: HTMLElement | null = null;
  let openingThumbnail: Thumbnail | undefined;
  let openingClosedTimes = 0;
  let reopenTimer: number | undefined;

  /**
   * 登録者10万人の記念の特別仕様のあいだは、始める前の画面のまん中に、記念配信のウィンドウを1枚置く。閉じられたら、閉じた回数だけ
   * 広げて置き直す。遊び始めていたら、置かない。
   */
  function placeOpening(): void {
    if (lastScore !== null || playing || !isCelebrating(Date.now())) return;
    opening = spawn(centerPosition, openingThumbnail, (popup) => {
      const image = popup.querySelector<HTMLElement>('[data-altf4-image]')!;
      const limit = maxPopupWidth(
        { width: layer.clientWidth, height: layer.clientHeight },
        { width: popup.offsetWidth, height: popup.offsetHeight },
        { width: image.offsetWidth, height: image.offsetHeight },
      );
      popup.style.width = `${openingWidth(popup.offsetWidth, openingClosedTimes, limit)}px`;
    });
  }

  function closeOpening(hadFocus: boolean): void {
    opening?.remove();
    opening = null;
    reopenTimer = window.setTimeout(placeOpening, openingReopenDelay(openingClosedTimes));
    openingClosedTimes++;
    // 閉じたウィンドウと一緒にフォーカスが消えるので、開き直すのを待つあいだも押せる妖精へ移す。
    if (hadFocus) fairy.focus();
  }

  function start(): void {
    // キーボードで始めた人が、そのまま × へ進めるようにする（押したボタンは消えるか押せなくなる）。
    const fromButton = document.activeElement === yesButton || document.activeElement === startButton;
    stopTimers();
    clearTimeout(reopenTimer);
    opening = null;
    for (const popup of layer.querySelectorAll('[data-altf4-popup]')) popup.remove();
    assistant.hidden = true;
    closed = 0;
    lastChainAt = null;
    chains = 0;
    thumbnails = upcoming;
    deck = [];
    // もう一回で出す動画を、遊んでいるあいだに選び直して取っておく。終わってから取ると、すぐ始め直したときに配信が出そろわない。
    void prepare();
    playing = true;
    startedAt = performance.now();
    startButton.disabled = true;
    status.textContent = 'スタート';
    spawnAnywhere();
    if (fromButton) layer.querySelector<HTMLButtonElement>('[data-altf4-close]')?.focus({ preventScroll: true });
    timers.add(
      window.setInterval(() => {
        if (timeIsUp()) return;
        if (shouldChain(performance.now(), lastChainAt, chains > 0, Math.random)) startChain();
        else spawnAnywhere();
      }, SPAWN_INTERVAL_MS),
    );
    timers.add(
      window.setInterval(() => {
        if (timeIsUp()) return;
        clock.textContent = formatClock(remainingSeconds(performance.now() - startedAt));
      }, CLOCK_INTERVAL_MS),
    );
  }

  function finish(): void {
    stopTimers();
    playing = false;
    clock.textContent = formatClock(0);
    status.textContent = `おわり。${closed}枚とじました`;
    startButton.textContent = 'もう一回';
    startButton.disabled = false;
    // 終えると × が効かなくなるので、ウィンドウの中にいたフォーカスを、妖精の「はい」へ移す。
    const focusWasInLayer = layer.contains(document.activeElement);
    lastScore = closed;
    assistant.hidden = false;
    ask();
    if (focusWasInLayer) yesButton.focus();
  }

  if (isCelebrating(Date.now())) {
    void loadThumbnails([OPENING_VIDEO_ID], (thumbnail) => {
      openingThumbnail = thumbnail;
      placeOpening();
    });
  }

  startButton.addEventListener('click', start);
  yesButton.addEventListener('click', start);
  noButton.addEventListener('click', () => {
    openBalloon(false);
    // 吹き出しごと消えるので、開き直せる妖精へ移す。
    fairy.focus();
  });
  fairy.addEventListener('click', () => {
    if (balloon.hidden) ask();
    else openBalloon(false);
  });

  desktop.addEventListener('click', (event) => {
    const target = event.target as Element;
    const close = target.closest<HTMLButtonElement>('[data-altf4-close]');
    if (close) {
      if (opening && close.closest('[data-altf4-popup]') === opening) {
        closeOpening(document.activeElement === close);
        return;
      }
      if (timeIsUp()) return;
      const hadFocus = document.activeElement === close;
      close.closest('[data-altf4-popup]')!.remove();
      closed++;
      // キーボードで遊ぶ人が続けて閉じられるよう、いちばん上（最後に開いた）のウィンドウの × へ移る。
      if (hadFocus) [...layer.querySelectorAll<HTMLButtonElement>('[data-altf4-close]')].at(-1)?.focus();
      return;
    }
    const ad = target.closest<HTMLAnchorElement>('[data-altf4-ad]');
    if (ad) {
      // 本物の広告のように、小さな別のウィンドウで開く（スマートフォンでは新しいタブになる）。
      event.preventDefault();
      // availLeft・availTop は標準に無いが、主なブラウザが持つ。画面を複数つなぐと、今の画面の左上が 0 にならない。
      const { availLeft, availTop, availWidth, availHeight } = screen as Screen & { availLeft?: number; availTop?: number };
      const features = adWindowFeatures({ left: availLeft ?? 0, top: availTop ?? 0, width: availWidth, height: availHeight });
      window.open(ad.href, '_blank', features);
      // 遊んでいるあいだなら、その回はここで終える。時間切れを過ぎていたら、timeIsUp が終える。
      if (!timeIsUp()) finish();
      return;
    }
    // ウィンドウの外やタイトルバーを押してしまったら、連鎖を起こす。
    // 始めるボタン（タスクバー・妖精）を押したクリックは、始めた直後にここへ届くので数えない。
    if (!target.closest('.taskbar, [data-altf4-assistant]') && !timeIsUp()) startChain();
  });
</script>

<style>
  @layer pages {
    h1 {
      margin: 0;
    }

    /* ゲームの外なので、昔のパソコンの見た目にせず、サイトのボタンの形にする。右の端に寄せる。 */
    .bgm {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-3);
      margin: var(--space-6) 0 0;
    }

    .bgm-toggle {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      min-height: var(--tap-size);
      padding: 0 var(--space-4) 0 var(--space-3);
      border: var(--border-thumb) solid var(--color-outline);
      border-radius: var(--radius-pill);
      background-color: var(--color-surface);
      color: var(--color-text);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      touch-action: manipulation;
    }

    /* 鳴っているかは、色と絵（音の波か ×）の両方で分ける。 */
    .bgm-toggle[aria-pressed='true'] {
      background-color: var(--color-fill-violet);
      color: var(--color-text-on-fill);
    }

    .bgm-toggle:disabled {
      cursor: default;
    }

    .bgm-toggle svg {
      width: 1.5rem;
      height: 1.5rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .bgm-toggle[aria-pressed='false'] .waves,
    .bgm-toggle[aria-pressed='true'] .cross {
      display: none;
    }

    .bgm-volume {
      width: min(10rem, 40vw);
      min-height: var(--tap-size);
      margin: 0;
    }

    .desktop {
      display: flex;
      flex-direction: column;
      height: clamp(26rem, 70vh, 40rem);
      margin: var(--space-3) 0 0;
      border: var(--border-card) solid var(--color-outline);
      border-radius: var(--radius-card);
      overflow: hidden;
      background: linear-gradient(to bottom, #3a7bd5 0%, #8cc0f2 62%, #6fae4a 62%, #4e8f33 100%);
      box-shadow: var(--offset-card) var(--offset-card) 0 var(--color-outline);
      /* 続けて押すと字が選ばれ、すばやく2回押すと拡大されてしまうため。Safari は接頭辞付きしか読まない。 */
      -webkit-user-select: none;
      /* stylelint-disable-next-line plugin/use-baseline -- Safari は上の接頭辞付きを読み、ほかのブラウザがこれを読む */
      user-select: none;
      touch-action: manipulation;
    }

    /* 配信のウィンドウの大きさを、ここの幅と高さから決める。 */
    .popups {
      position: relative;
      flex: 1;
      overflow: hidden;
      container-type: size;
    }

    .taskbar {
      display: flex;
      align-items: stretch;
      gap: var(--space-2);
      min-height: var(--tap-size);
      background: linear-gradient(to bottom, #3168d5 0%, #2457c4 10%, #1f4fb5 90%, #173e93 100%);
      color: #fff;
    }

    .taskbar p {
      display: flex;
